rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Role-based logic (requires a lookup)
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData(request.auth.uid).role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    // USERS
    match /users/{userId} {
      allow get: if isSignedIn(); // Allow get for profile lookups
      allow list: if isAdmin();
      allow create: if isOwner(userId) && incoming().role in ['student', 'driver', 'marshal', 'admin']; 
      allow update: if isOwner(userId) && (
        // Only allow updating name and avatar, not role (except by admin)
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar']) || isAdmin()
      );
    }

    // BUSES
    match /buses/{busId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasRole('driver'); // Simplification for now
    }

    // BOOKINGS
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // BUS REQUESTS
    match /busRequests/{requestId} {
      allow read: if isSignedIn() && (hasRole('marshal') || isAdmin());
      allow create: if hasRole('marshal');
      allow update: if isAdmin();
    }
  }
}
